@model IEnumerable<Real_Estate___Rental_System_CRUD.Models.PropertyType>

@{
    ViewData["Title"] = "أنواع العقارات";
}

<h1>أنواع العقارات</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> عقار جديد
    </a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Name
            </th>
            <th>
                عدد العقارات 
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.Name
            </td>
                <td>@item.Properties?.Count()</td>
            <td>
               <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">تعديل</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm text-white">تفاصيل</a>
              <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">حذف</a>
            </td>
        </tr>
}
    </tbody>
</table>
