@model Real_Estate___Rental_System_CRUD.Models.Tenant
@{
    ViewData["Title"] = "Delete Tenant";
}

<div class="container">
    <h1 class="text-danger">Delete Tenant</h1>
    <h3>Are you sure you want to delete this tenant?</h3>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="form-group mb-3">
            <label asp-for="FullName" class="control-label"></label>
            <input asp-for="FullName" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label asp-for="NationalId" class="control-label"></label>
            <input asp-for="NationalId" class="form-control" readonly />
        </div>

        <div class="form-group mt-4">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
    <div class="mt-3">
        <a asp-action="Index">Back to List</a>
    </div>
</div>
