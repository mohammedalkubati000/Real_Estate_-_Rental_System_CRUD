@model Real_Estate___Rental_System_CRUD.Models.Payment
@{
    ViewData["Title"] = "Delete Payment";
}

<div class="container">
    <h1 class="text-danger">حذف السجل المالي</h1>
    <h3>Are you sure you want to delete this payment record?</h3>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="form-group mb-3">
            <label asp-for="Id" class="control-label">رقم السداد</label>
            <input asp-for="Id" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label asp-for="AmountPaid" class="control-label">المبلغ المحذوف</label>
            <input asp-for="AmountPaid" class="form-control" readonly />
        </div>

        <div class="form-group mt-4">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
    <div class="mt-3">
        <a asp-action="Index">Back to List</a>
    </div>
</div>
