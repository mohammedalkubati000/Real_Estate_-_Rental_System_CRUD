@model Real_Estate___Rental_System_CRUD.Models.RentalContract
@{
    ViewData["Title"] = "Create Contract";
}

<div class="container">
    <h1>إنشاء عقد إيجار جديد</h1>
    <form asp-action="Create" method="post">

        <div class="text-danger" asp-validation-summary="All">
        </div>

        <div class="form-group mb-3">
            <label asp-for="PropertyId" class="control-label">اختر العقار المتاح</label>
            <select asp-for="PropertyId" class="form-control" asp-items="ViewBag.PropertyId">
                <option value="">-- اختر العقار عن طريق العنوان --</option>
            </select>
            <span class="text-danger" asp-validation-for="PropertyId"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="TenantId" class="control-label">اختر المستأجر</label>
            <select asp-for="TenantId" class="form-control" asp-items="ViewBag.TenantId">
                <option value="">-- اختر المستأجر عن طريق الاسم --</option>
            </select>
            <span class="text-danger" asp-validation-for="TenantId"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="StartDate" class="control-label"></label>
            <input asp-for="StartDate" class="form-control" type="date" />
            <span class="text-danger" asp-validation-for="StartDate"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="EndDate" class="control-label"></label>
            <input asp-for="EndDate" class="form-control" type="date" />
            <span class="text-danger" asp-validation-for="EndDate"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="ContractValue" class="control-label"></label>
            <input asp-for="ContractValue" class="form-control" type="number" step="0.01" />
            <span class="text-danger" asp-validation-for="ContractValue"></span>
        </div>

        <div class="form-group mt-4">
            <input type="submit" value="Create" class="btn btn-primary" />
        </div>
    </form>
    <div class="mt-3">
        <a asp-action="Index">Back to List</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
