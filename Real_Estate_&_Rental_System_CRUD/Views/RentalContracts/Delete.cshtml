@model Real_Estate___Rental_System_CRUD.Models.RentalContract
@{
    ViewData["Title"] = "Delete Contract";
}

<div class="container">
    <h1 class="text-danger">حذف وإلغاء عقد الإيجار</h1>
    <h3 class="text-muted mb-4">هل أنت متأكد من رغبتك في حذف هذا العقد بشكل نهائي؟ (سيتم إعادة العقار متاحاً تلقائياً)</h3>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="form-group mb-3">
            <label asp-for="Id" class="control-label">رقم العقد</label>
            <input asp-for="Id" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label asp-for="Property.Address" class="control-label">عنوان العقار</label>
            <input asp-for="Property.Address" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label asp-for="Tenant.FullName" class="control-label">اسم المستأجر</label>
            <input asp-for="Tenant.FullName" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label asp-for="ContractValue" class="control-label">قيمة العقد</label>
            <input asp-for="ContractValue" class="form-control" readonly />
        </div>

        <div class="form-group mt-4">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
    <div class="mt-3">
        <a asp-action="Index">Back to List</a>
    </div>
</div>
