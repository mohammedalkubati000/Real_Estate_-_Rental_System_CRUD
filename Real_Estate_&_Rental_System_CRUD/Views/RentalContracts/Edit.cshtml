@model Real_Estate___Rental_System_CRUD.Models.RentalContract
@{
    ViewData["Title"] = "Edit Contract";
}

<div class="container">
    <h1>تعديل عقد الإيجار</h1>
    <form asp-action="Edit" method="post">

        <!-- 💡 حقل مخفي لحفظ معرف العقد لكي تتم عملية التحديث بنجاح -->
        <input type="hidden" asp-for="Id" />

        <div class="text-danger" asp-validation-summary="All">
        </div>

        <div class="form-group mb-3">
            <label asp-for="PropertyId" class="control-label">تغيير العقار</label>
            <select asp-for="PropertyId" class="form-control" asp-items="ViewBag.PropertyId"></select>
            <span class="text-danger" asp-validation-for="PropertyId"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="TenantId" class="control-label">تغيير المستأجر</label>
            <select asp-for="TenantId" class="form-control" asp-items="ViewBag.TenantId"></select>
            <span class="text-danger" asp-validation-for="TenantId"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="StartDate" class="control-label"></label>
            <input asp-for="StartDate" class="form-control" type="date" />
            <span class="text-danger" asp-validation-for="StartDate"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="EndDate" class="control-label"></label>
            <input asp-for="EndDate" class="form-control" type="date" />
            <span class="text-danger" asp-validation-for="EndDate"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="ContractValue" class="control-label"></label>
            <input asp-for="ContractValue" class="form-control" type="number" step="0.01" />
            <span class="text-danger" asp-validation-for="ContractValue"></span>
        </div>

        <div class="form-group mt-4">
            <input type="submit" value="Update" class="btn btn-warning" />
        </div>
    </form>
    <div class="mt-3">
        <a asp-action="Index">Back to List</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
