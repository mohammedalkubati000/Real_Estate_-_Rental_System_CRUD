@model Real_Estate___Rental_System_CRUD.Models.Property
@{
    ViewData["Title"] = "Delete Property";
}

<div class="container">
    <h1 class="text-danger">Delete Property</h1>
    <h3>Are you sure you want to delete this property?</h3>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="form-group mb-3">
            <label asp-for="PropertyType" class="control-label"></label>
            <input asp-for="PropertyType" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label asp-for="City" class="control-label"></label>
            <input asp-for="City" class="form-control" readonly />
        </div>

        <div class="form-group mb-3">
            <label asp-for="Address" class="control-label"></label>
            <textarea asp-for="Address" class="form-control" readonly></textarea>
        </div>

        <div class="form-group mt-4">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
    <div class="mt-3">
        <a asp-action="Index">Back to List</a>
    </div>
</div>
