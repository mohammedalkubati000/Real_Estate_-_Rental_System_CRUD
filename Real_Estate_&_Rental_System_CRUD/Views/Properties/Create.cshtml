@model Real_Estate___Rental_System_CRUD.Models.Property
@{
    ViewData["Title"] = "Create Property";
}

<div class="container">
    <h1>Create Property</h1>
    <form asp-action="Create" method="post">

        <div class="text-danger" asp-validation-summary="All">
        </div>
        <!--  
        <div class="form-group mb-3">
            <label asp-for="PropertyTypeId" class="control-label"></label>
            <input asp-for="PropertyTypeId" class="form-control" />
            <span class="text-danger" asp-validation-for="PropertyTypeId"></span>
        </div>  is on
        -->
        <div class="form-group mb-3">
            <label asp-for="PropertyTypeId" class="control-label">نوع العقار</label>
            <select asp-for="PropertyTypeId" class="form-control" asp-items="ViewBag.d">
                <option value=""> اختر النوع </option>
            </select>
            <span class="text-danger" asp-validation-for="PropertyTypeId"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="City" class="control-label"></label>
            <input asp-for="City" class="form-control" />
            <span class="text-danger" asp-validation-for="City"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Address" class="control-label"></label>
            <textarea asp-for="Address" class="form-control"></textarea>
            <span class="text-danger" asp-validation-for="Address"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="AnnualRent" class="control-label"></label>
            <input asp-for="AnnualRent" class="form-control" type="number" step="0.01" />
            <span class="text-danger" asp-validation-for="AnnualRent"></span>
        </div>

        <div class="form-group mt-4">
            <input type="submit" value="Create" class="btn btn-primary" />
        </div>
    </form>
    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
