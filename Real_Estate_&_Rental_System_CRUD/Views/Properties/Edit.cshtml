@model Real_Estate___Rental_System_CRUD.Models.Property
@{
    ViewData["Title"] = "Edit Property";
}

<div class="container">
    <h1>Edit Property</h1>
    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="text-danger" asp-validation-summary="All">
        </div>

        <div class="form-group mb-3">
            <label asp-for="PropertyType" class="control-label"></label>
            <input asp-for="PropertyType" class="form-control" />
            <span class="text-danger" asp-validation-for="PropertyType"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="City" class="control-label"></label>
            <input asp-for="City" class="form-control" />
            <span class="text-danger" asp-validation-for="City"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Address" class="control-label"></label>
            <textarea asp-for="Address" class="form-control"></textarea>
            <span class="text-danger" asp-validation-for="Address"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="AnnualRent" class="control-label"></label>
            <input asp-for="AnnualRent" class="form-control" type="number" step="0.01" />
            <span class="text-danger" asp-validation-for="AnnualRent"></span>
        </div>

        <div class="form-group mb-3 form-check">
            <label class="form-check-label">
                <input class="form-check-input" asp-for="IsAvailable" /> @Html.DisplayNameFor(model => model.IsAvailable)
            </label>
        </div>

        <div class="form-group mt-4">
            <input type="submit" value="Update" class="btn btn-warning" />
        </div>
    </form>
    <div class="mt-3">
        <a asp-action="Index">Back to List</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
